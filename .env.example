# ================================================================
# 💰 PROXPOOL MULTI-PROXY DOCKER CONFIGURATION (.env.example)
# Copy this file to .env and fill in the services you want to run!
# ================================================================

DEVICE_NAME=US-Node

# 1. EarnApp (Automatically enabled & generates a unique claim URL per proxy)
ENABLE_EARNAPP=true

# 2. TraffMonetizer (https://traffmonetizer.com/?aff=314445)
TRAFFMONETIZER_TOKEN=

# 3. Pawns.app / IPRoyal (https://pawns.app/?r=321983)
PAWNS_EMAIL=
PAWNS_PASSWORD=

# 4. PacketStream (https://packetstream.io/?psr=8NiR)
PACKETSTREAM_CID=

# 5. Honeygain (https://join.honeygain.com/DEAVAD6A97)
HONEYGAIN_EMAIL=
HONEYGAIN_PASSWORD=

# 6. EarnFM (https://earn.fm/ref/ABYAZFJG)
EARNFM_TOKEN=

# 7. Repocket (https://hub.docker.com/r/repocket/repocket)
REPOCKET_EMAIL=
REPOCKET_API_KEY=

# 8. ProxyRack Peer (https://peer.proxyrack.com/ref/lhrj04uv98ugrcfsipjw27hexia0vhymyrrkfxub)
PROXYRACK_API_KEY=

# 9. ProxyLite (https://proxylite.ru/?r=0NZ2N4LU)
PROXYLITE_USER_ID=

# 10. PacketShare (https://packetshare.io)
PACKETSHARE_EMAIL=
PACKETSHARE_PASSWORD=

# 11. Grass Network DePIN (https://app.getgrass.io)
GRASS_USER_ID=

# 12. Presearch Node (https://nodes.presearch.com)
PRESEARCH_REGISTRATION_CODE=

# 13. ProxyBase AI Agent Node (https://proxybase.xyz/console?ref=free1usd)
PROXYBASE_WALLET=
